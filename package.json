{
  "name": "dsh-watchdog-monitor",
  "version": "0.1.4",
  "description": "可注册、只读的看门狗工作区",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SELFTEST.md",
    "BADGE.md",
    "RELEASE.md",
    "docs/DSH-API-EVIDENCE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "connection"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fire-Phoenixs/dsh-watchdog-monitor.git"
  },
  "homepage": "https://github.com/Fire-Phoenixs/dsh-watchdog-monitor#readme",
  "bugs": {
    "url": "https://github.com/Fire-Phoenixs/dsh-watchdog-monitor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "watchdog",
    "monitoring",
    "readonly",
    "systemd",
    "windows-task",
    "docker"
  ]
}
